# Şemayı yükleyebilmem için gereken iki gizli değer.
# Bu dosyayı .env.local olarak kopyalayıp doldurun — .gitignore'da, sohbete girmez.
#
# 1) Kişisel erişim jetonu:
#    supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_...
#
# 2) Projeyi kurarken belirlediğiniz veritabanı parolası
#    (unuttuysanız: Project Settings → Database → Reset database password)
SUPABASE_DB_PASSWORD=...
